# EcoMind AI — Gemini API Key Configuration
# You can provide a single key or a comma-separated list of keys for automatic failover/rotation.
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5
# Fallback single key setting
GEMINI_API_KEY=your_primary_key_here

GEMINI_MODEL=gemini-flash-latest
ENVIRONMENT=development
DEBUG=true
